# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Postgres connection string (Neon free tier works well). Use the "pooled" URL.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The password you type to open the studio. Use something long.
ADMIN_PASSWORD=change-me-to-something-long

# Random secret used to sign your login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cloudflare R2 (Dashboard → R2 → Manage API tokens → Create token with Object Read & Write on your bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=photography
# Only needed for local testing against an S3-compatible stand-in; leave empty for R2.
R2_ENDPOINT=
